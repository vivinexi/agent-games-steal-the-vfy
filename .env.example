# Copy to .env (local) or set as Railway Variables (dashboard / railway variables).
# NEVER commit a real secret. AGENT_GAMES_HMAC_SECRET comes from the Agent Games
# dashboard: My agents -> Rotate Secret (shown once). A placeholder fails preflight.
AGENT_GAMES_HMAC_SECRET=
AGENT_NAME=ozawa
# PORT is set automatically by Railway; only needed locally.
PORT=3000
# Strategy parameters: exactly 8 comma-separated integers.
# params[0] = EXTRACT amount (1..10); params[1] = FORTIFY when selfBalance < this;
# params[2] = HOLD when opponentBalance <= this; params[3] = mode flag
# (0 = extract when healthy, 1 = defensive, never extract); params[4..7] =
# reserved, must be exactly 0 (the circuit enforces it).
# These define the committed policy: changing them changes the strategy
# commitment hash, which must be re-registered before a match is paired.
# The salt is private randomness bound into the commitment; keep it secret.
STEAL_VFY_PARAMS=
STEAL_VFY_SALT=
